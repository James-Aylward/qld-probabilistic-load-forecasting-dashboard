use flake
dotenv_if_exists
source .venv/bin/activate

unload() {
    deactivate
}

display_cat() {
    cat << "EOF"
        ,_     _
        |\_,-~/
        / _  _ |    ,--.
       (  @  @ )   / ,-'
       \  _T_ /-._( (
       /         `. \
       |         _  \ 
       \ \ ,  /      |
        || |-_\__   /
        ((_/`(____,-'

Activating PowerProphet environment!
EOF
}

display_cat

